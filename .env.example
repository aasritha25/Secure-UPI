# Secure UPI: Environment Configuration Template

# Application Secret Key
SECRET_KEY=secure-upi-prod-secret-key-change-in-production-2026

# JWT Authentication Secret Key
JWT_SECRET_KEY=jwt-super-secret-key-for-secure-upi-auth-token-32bytes-min
JWT_EXPIRES_HOURS=12

# Database Connection URI
# Default local SQLite:
# DATABASE_URL=sqlite:///secure_upi.db
# MySQL Database Connection (Production):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/secure_upi

# Fraud Risk Thresholds (Configurable academic demonstration ranges)
LOW_RISK_MAX=30.0
MEDIUM_RISK_MAX=70.0
HIGH_RISK_MIN=71.0

# Server Settings
PORT=5000
FLASK_DEBUG=True
